AGENT1_BASE_URL=http://127.0.0.1:8000
AGENT2_BASE_URL=http://127.0.0.1:8001
AGENT2_API_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=120.0

# Agent 3 (Analytics Agent) — FastAPI service, port 8003.
ANALYTICS_AGENT_BASE_URL=http://127.0.0.1:8003
ANALYTICS_AGENT_TIMEOUT_SECONDS=120.0

# Dataset Registry (Stage 0A) — shared native Postgres instance used by
# Agent 1/2/3 too. Usually inherited from the shared root .env; only set
# these here if this service should point at a different instance.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mva_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MASTER_DATASET_STORAGE_DIR=./data/master-datasets
