# Database
DATABASE_URL=postgresql://mva_user:mva_password@localhost:5433/mva_pipeline
DATABASE_ECHO=false

# File Limits
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=200000
MAX_DATASET_COLUMNS=200
PROCESSING_TIMEOUT_SECONDS=120

# Temporary Storage
TEMP_STORAGE_DIR=./tmp/uploads
MAX_SAMPLE_VALUES=10

# Drill-down Cubes
MIN_CUBE_GROUP_SIZE=5
MAX_DRILL_DOWN_LEVELS=5

# LLM Provider — AZURE_OPENAI_API_KEY/ENDPOINT/DEPLOYMENT/API_VERSION are
# NOT set here: they're inherited from the shared repo-root .env (same
# convention Agent 1/3 already use for their own LLM credentials), so one
# root-level config drop-in covers this service too. Set LLM_PROVIDER=mock
# here only to disable real LLM calls entirely (tests / demos without a key).
LLM_PROVIDER=azure
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_BURST_COOLDOWN_SECONDS=5

# Schema Intelligence
SCHEMA_INTELLIGENCE_PROVIDER=local

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application
APP_ENV=development
APP_DEBUG=false
API_PREFIX=/api/v1

# Authentication (leave empty to disable)
API_KEYS=[]
JWT_SECRET=
JWT_ALGORITHM=HS256
